        <mxCell id="a1" value="1. S'authentifie" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#111827;fontColor=#111827;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;entryX=1;entryY=0.05;" edge="1" parent="1" source="admin" target="systeme"><mxGeometry x="-0.25" y="10" relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="2. Gère les comptes utilisateurs" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#111827;fontColor=#111827;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.45;entryX=1;entryY=0.23;" edge="1" parent="1" source="admin" target="systeme"><mxGeometry x="-0.15" y="5" relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="3. Gère le matériel et les stocks" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#111827;fontColor=#111827;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.65;entryX=1;entryY=0.40;" edge="1" parent="1" source="admin" target="systeme"><mxGeometry x="-0.05" y="0" relative="1" as="geometry"/></mxCell>
